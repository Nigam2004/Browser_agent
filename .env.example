# Mantra portal
MANTRA_URL=https://your-mantra-portal-login-url
MANTRA_USERNAME=your_username
MANTRA_PASSWORD=your_password

# CSS selectors: inspect the real Mantra page and change these if needed.
MANTRA_USERNAME_SELECTOR=input[name="UserName"]
MANTRA_PASSWORD_SELECTOR=input[name="Password"]
MANTRA_CAPTCHA_IMAGE_SELECTOR=#imgcaptcha
MANTRA_CAPTCHA_INPUT_SELECTOR=input[name="Captcha"]
MANTRA_LOGIN_BUTTON_SELECTOR=button:has-text("Login")

# Recommended: set a selector that is visible ONLY after successful login.
# Example placeholder; replace with a real dashboard element from your portal.
MANTRA_LOGIN_SUCCESS_SELECTOR=
# Optional: selector/text container shown when login fails.
MANTRA_LOGIN_ERROR_SELECTOR=

# Optional selector for Add Worker navigation control.
# If blank, the agent searches visible text "Add Worker".
MANTRA_ADD_WORKER_SELECTOR=

# REQUIRED to verify the Add Worker form and inspect its first field.
# Replace with the real first field selector on your Add Worker page.
MANTRA_FIRST_WORKER_FIELD_SELECTOR=

BROWSER_HEADLESS=false
BROWSER_TIMEOUT_MS=30000
